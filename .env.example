# Example process environment settings. All values below are placeholders.
# The application does not load this file automatically.
# Keep real environment files and credentials out of source control.

# Generate your own value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-session-signing-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-your-own-local-password
# Optional multi-user configuration (overrides the single administrator):
# Generate an entry with: python scripts/make_user.py
#USERS_JSON=[{"email":"viewer@example.com","hash":"<hex>","salt":"<hex>","role":"viewer","allowed_paths":["*"]}]

# Use true when serving through HTTPS.
HTTPS_ONLY=false
# Guest sessions can browse the image library. Use synthetic demo data.
ALLOW_GUEST_PROCESSING=false

#IMAGES_DIR=./scans
#INCOMING_SCANS_DIR=./incoming
# Optional external service; not needed for viewing images.
#OME_GENERATOR_URL=http://127.0.0.1:8001

# Optional local catalog. Do not commit its database.
#DATABASE_URL=sqlite:///./catalog-local.db
# Azure PostgreSQL example; replace every placeholder and use verified TLS:
#DATABASE_URL=postgresql+psycopg://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
CATALOG_DEFAULT=false
CATALOG_LEGACY_BROWSER=true
CATALOG_SCAN_INTERVAL=180

# Optional separate event worker: python -m scripts.catalog_worker events
# Set the actual storage account explicitly; no deployed account is bundled.
#COREVIEW_STORAGE_ACCOUNT=examplestorage
#CATALOG_SERVICE_BUS_QUEUE=ome-generated
# Supply one of these authentication modes through the environment:
#CATALOG_SERVICE_BUS_CONNECTION_STRING=<queue-scoped-listen-connection-string>
#SERVICE_BUS_NAMESPACE=<namespace>.servicebus.windows.net
