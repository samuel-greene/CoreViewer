# =============================================================================
# .env.example — copy this to .env and fill in real values for local dev.
# .env is listed in .gitignore and must NEVER be committed.
#
# In Azure, these are set as Container App environment variables (see README).
# SECRET_KEY and ADMIN_PASSWORD (or USERS_JSON) should be stored in Key Vault
# and referenced as secrets — not entered as plain-text env vars in the portal.
# =============================================================================

# ---------------- Gap 1: session signing key ---------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Store the production value in Azure Key Vault → secret: coreview-secret-key
SECRET_KEY=replace-with-a-long-random-hex-string

# ---------------- Gap 2: user credentials ------------------------------------
# Mode B (simple): single admin account.
# The app hashes ADMIN_PASSWORD at startup — never store a pre-hashed value here.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=your-local-dev-password

# Mode A (multi-user): JSON array of pre-hashed users — overrides Mode B.
# Generate entries with:  python3 scripts/make_user.py
# Leave blank to use Mode B above.
#USERS_JSON=[{"email":"viewer@example.com","hash":"<hex>","salt":"<hex>","role":"viewer","allowed_paths":["*"]}]

# ---------------- Gap 3: cookie security -------------------------------------
# false = allow HTTP (local dev)
# true  = require HTTPS (Azure — set this in Container App env vars, not here)
HTTPS_ONLY=false

# ---------------- Image mount path -------------------------------------------
# Leave unset locally (defaults to ./scans).
# Set to /mnt/images in the Azure Container App.
#IMAGES_DIR=/mnt/images

# ---------------- Incoming Azure Files share --------------------------------
# Mount the Azure Files share named "incoming-scans" in the Container App at
# /mnt/incoming-scans, or set this variable to the configured mount directory.
# The Incoming tab reports a clear unavailable status if the mount is absent.
#INCOMING_SCANS_DIR=/mnt/incoming-scans
