# =============================================================================
# .env.example — copy this to .env and fill in real values for local dev.
# .env is listed in .gitignore and must NEVER be committed.
#
# In Azure, these are set as Container App environment variables (see README).
# SECRET_KEY and ADMIN_PASSWORD (or USERS_JSON) should be stored in Key Vault
# and referenced as secrets — not entered as plain-text env vars in the portal.
# =============================================================================

# ---------------- Gap 1: session signing key ---------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Store the production value in Azure Key Vault → secret: coreview-secret-key
SECRET_KEY=replace-with-a-long-random-hex-string

# ---------------- Gap 2: user credentials ------------------------------------
# Mode B (simple): single admin account.
# The app hashes ADMIN_PASSWORD at startup — never store a pre-hashed value here.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=your-local-dev-password

# Mode A (multi-user): JSON array of pre-hashed users — overrides Mode B.
# Generate entries with:  python3 scripts/make_user.py
# Leave blank to use Mode B above.
#USERS_JSON=[{"email":"viewer@example.com","hash":"<hex>","salt":"<hex>","role":"viewer","allowed_paths":["*"]}]

# ---------------- Gap 3: cookie security -------------------------------------
# false = allow HTTP (local dev)
# true  = require HTTPS (Azure — set this in Container App env vars, not here)
HTTPS_ONLY=false

# ---------------- Image mount path -------------------------------------------
# Leave unset locally (defaults to ./scans).
# Set to /mnt/images in the Azure Container App.
#IMAGES_DIR=/mnt/images

# ---------------- Incoming Azure Files share --------------------------------
# Mount the Azure Files share named "incoming-scans" in the Container App at
# /mnt/incoming-scans, or set this variable to the configured mount directory.
# The Incoming tab reports a clear unavailable status if the mount is absent.
#INCOMING_SCANS_DIR=/mnt/incoming-scans


# ---------------- Manual OME conversion connection ----------------------------
# Generator URL is used only by the server. Azure: http://ome-generator
#OME_GENERATOR_URL=http://127.0.0.1:8001
# No generator API key is required. Keep the generator ingress internal.
# IMAGES_DIR must mount the generator output share for Open result to work.
# USERS_JSON accounts with role admin or processor can submit conversions.
# Guests can also submit, retry and track conversions for now (default true).
# Set false in Azure to restrict processing to admin/processor accounts.
ALLOW_GUEST_PROCESSING=true

# ---------------- Search catalog (optional until backfill is validated) -----
# Use Azure Database for PostgreSQL Flexible Server in production. Store this
# connection string as a Container App secret. Verify the server hostname and
# certificate using the CA bundle explicitly installed in the container image.
# Local development may use sqlite:///./catalog-local.db.
#DATABASE_URL=postgresql+psycopg://catalog_user:password@server.postgres.database.azure.com:5432/coreview?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
# Keep false through the first import and validation. When true, Library is
# the default interface and Folders remains an admin-only rollout fallback.
CATALOG_DEFAULT=false
# Keep true during rollout for an admin-only Folders tab, then set false to
# retire folder navigation after the catalog has proven complete.
CATALOG_LEGACY_BROWSER=true
# Run exactly one separate worker with the same output-share mount.
CATALOG_SCAN_INTERVAL=180

# Event-driven catalog worker: python -m scripts.catalog_worker events
# Keep one receiver replica running; the viewer itself needs no broker settings.
# Store the queue-scoped Listen connection string as a Container Apps secret.
#CATALOG_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...;SharedAccessKeyName=consumer;SharedAccessKey=...
#CATALOG_SERVICE_BUS_QUEUE=ome-generated
#COREVIEW_STORAGE_ACCOUNT=examplestorage
# Alternative: SERVICE_BUS_NAMESPACE=<namespace>.servicebus.windows.net plus
# an identity granted Azure Service Bus Data Receiver on the catalog queue.
