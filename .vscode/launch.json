{
  "version": "0.2.0",
  "configurations": [
    {
        "name": "OME-TIFF Viewer (Uvicorn)",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
            "main:app",
            "--reload"
        ],
        "cwd": "${workspaceFolder}/viewer",
        "jinja": false,
        "justMyCode": true
    },
    {
        "name": "Containers: Python - Fastapi",
        "type": "docker",
        "request": "launch",
        "preLaunchTask": "docker-run: debug",
        "python": {
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ],
            "projectType": "fastapi"
        }
    }
]
}
